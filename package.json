{
  "name": "super-pads",
  "version": "1.3.0",
  "description": "Super Pads helps manage samples on a SP-404SX",
  "author": "Matthew Callis <matthew.callis@gmail.com>",
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewCallis/super-pads.git"
  },
  "bugs": {
    "url": "https://github.com/MatthewCallis/super-pads/issues"
  },
  "homepage": "https://github.com/MatthewCallis/super-pads",
  "keywords": [
    "sp404",
    "sp404sx",
    "sp404a",
    "roland",
    "sampler"
  ],
  "main": "src/main.js",
  "files": [
    "src/**/*",
    "index.html",
    "style.css",
    "fonts/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "scss": "sass --watch --style=compressed --no-source-map style.scss:style.css",
    "scss-build": "sass --style=compressed --no-source-map style.scss style.css",
    "test": "node --test test/*.test.js",
    "test:smoke": "electron scripts/smoke-test.js",
    "make-icons": "node scripts/make-icons.js",
    "build": "electron-builder build --mac",
    "package": "electron-builder build --mac --win --linux --publish never",
    "package-mac": "electron-builder build --mac",
    "package-mac-arm": "electron-builder build --mac --arm64",
    "package-mac-x64": "electron-builder build --mac --x64",
    "package-linux": "electron-builder build --linux",
    "package-win": "electron-builder build --win --x64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "sass": "^1.105.1"
  },
  "dependencies": {
    "@uttori/data-tools": "^5.1.1",
    "ffmpeg-static-electron": "^2.0.3",
    "waveform-data": "^4.5.2"
  },
  "build": {
    "appId": "org.superfamicom.super-pads",
    "productName": "Super Pads",
    "directories": {
      "buildResources": "build-resources"
    },
    "files": [
      "node_modules",
      "index.html",
      "style.css",
      "src/**/*",
      "fonts/**/*",
      "!node_modules/ffmpeg-static-electron/bin/!(${os})${/*}",
      "!node_modules/ffmpeg-static-electron/bin/${os}/!(${arch})${/*}",
      "!node_modules/**/LICENSE",
      "!node_modules/**/*.md",
      "!node_modules/**/Makefile"
    ],
    "asar": {
      "smartUnpack": true
    },
    "artifactName": "${productName}-${os}.${ext}",
    "mac": {
      "asar": true,
      "asarUnpack": [
        "node_modules/ffmpeg-static-electron/package.json",
        "node_modules/ffmpeg-static-electron/index.js",
        "node_modules/ffmpeg-static-electron/bin/mac${/*}"
      ],
      "hardenedRuntime": true,
      "appId": "org.superfamicom.super-pads",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0.0",
      "type": "distribution",
      "artifactName": "${productName}-${os}-${arch}.${ext}",
      "entitlements": "build-resources/entitlements.plist",
      "entitlementsInherit": "build-resources/entitlements.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.icns"
    },
    "win": {
      "asar": true,
      "asarUnpack": [
        "node_modules/ffmpeg-static-electron/package.json",
        "node_modules/ffmpeg-static-electron/index.js",
        "node_modules/ffmpeg-static-electron/bin/win${/*}"
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "linux": {
      "asar": true,
      "asarUnpack": [
        "node_modules/ffmpeg-static-electron/package.json",
        "node_modules/ffmpeg-static-electron/index.js",
        "node_modules/ffmpeg-static-electron/bin/linux${/*}"
      ],
      "category": "Utility",
      "executableName": "super-pads",
      "icon": "icons/png/512x512.png",
      "target": [
        {
          "target": "tar.bz2",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true
  }
}
